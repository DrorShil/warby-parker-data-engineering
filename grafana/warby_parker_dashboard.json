      "panel-3": {
        "kind": "Panel",
        "spec": {
          "id": 3,
          "title": "Conversion Rates (%)",
          "description": "Quiz \u2192 Home Try-On, Try-On \u2192 Purchase, and overall conversion, all as percentages.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "grafana-postgresql-datasource",
                      "version": "v0",
                      "datasource": {
                        "name": "dfzt3gx4gf9xce"
                      },
                      "spec": {
                        "dataset": "warby_parker",
                        "editorMode": "code",
                        "format": "table",
                        "rawQuery": true,
                        "rawSql": "WITH funnel AS (\r\n  SELECT q.user_id,\r\n         hto.user_id IS NOT NULL AS is_home_try_on,\r\n         prch.user_id IS NOT NULL AS is_purchase\r\n  FROM quiz q\r\n  LEFT JOIN home_try_on hto ON q.user_id = hto.user_id\r\n  LEFT JOIN purchase prch ON q.user_id = prch.user_id\r\n)\r\nSELECT \r\n  ROUND(100.0 * SUM(CASE WHEN is_home_try_on THEN 1 ELSE 0 END) / COUNT(*), 2) AS quiz_to_tryon_pct,\r\n  ROUND(100.0 * SUM(CASE WHEN is_purchase THEN 1 ELSE 0 END) / SUM(CASE WHEN is_home_try_on THEN 1 ELSE 0 END), 2) AS tryon_to_purchase_pct,\r\n  ROUND(100.0 * SUM(CASE WHEN is_purchase THEN 1 ELSE 0 END) / COUNT(*), 2) AS overall_conversion_pct\r\nFROM funnel;",
                        "sql": {
                          "columns": [
                            {
                              "parameters": [],
                              "type": "function"
                            }
                          ],
                          "groupBy": [
                            {
                              "property": {
