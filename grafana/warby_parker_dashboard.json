        "spec": {
          "id": 1,
          "title": "Style Quiz Completion by Question",
          "description": "How many users answered each of the 5 quiz questions \u2014 shows exactly where drop-off happens.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
