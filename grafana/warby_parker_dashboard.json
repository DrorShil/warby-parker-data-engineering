      "panel-4": {
        "kind": "Panel",
        "spec": {
          "id": 4,
          "title": "A/B Test: Purchase Rate by Pairs Offered",
          "description": "Total users, purchases, and purchase rate broken down by how many pairs were tried at home.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "grafana-postgresql-datasource",
                      "version": "v0",
                      "datasource": {
                        "name": "dfzt3gx4gf9xce"
                      },
                      "spec": {
                        "dataset": "warby_parker",
                        "editorMode": "code",
                        "format": "table",
                        "rawQuery": true,
                        "rawSql": "WITH funnel AS (\r\n  SELECT hto.number_of_pairs,\r\n         prch.user_id IS NOT NULL AS is_purchase\r\n  FROM quiz q\r\n  LEFT JOIN home_try_on hto ON q.user_id = hto.user_id\r\n  LEFT JOIN purchase prch ON q.user_id = prch.user_id\r\n)\r\nSELECT number_of_pairs,\r\n       COUNT(*) AS total_users,\r\n       SUM(CASE WHEN is_purchase THEN 1 ELSE 0 END) AS total_purchases,\r\n       ROUND(100.0 * SUM(CASE WHEN is_purchase THEN 1 ELSE 0 END) / COUNT(*), 2) AS purchase_rate_pct\r\nFROM funnel\r\nWHERE number_of_pairs IS NOT NULL\r\nGROUP BY number_of_pairs;",
                        "sql": {
