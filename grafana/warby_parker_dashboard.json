      "panel-2": {
        "kind": "Panel",
        "spec": {
          "id": 2,
          "title": "Overall Funnel Stages Volume",
          "description": "User counts at each stage of the funnel: quiz takers, home try-on requests, and purchases.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "grafana-postgresql-datasource",
                      "version": "v0",
                      "datasource": {
                        "name": "dfzt3gx4gf9xce"
                      },
                      "spec": {
                        "dataset": "warby_parker",
                        "editorMode": "code",
                        "format": "table",
                        "rawQuery": true,
                        "rawSql": "WITH funnel AS (\r\n  SELECT q.user_id,\r\n         hto.user_id IS NOT NULL AS is_home_try_on,\r\n         prch.user_id IS NOT NULL AS is_purchase\r\n  FROM quiz q\r\n  LEFT JOIN home_try_on hto ON q.user_id = hto.user_id\r\n  LEFT JOIN purchase prch ON q.user_id = prch.user_id\r\n)\r\nSELECT '1. Quiz Users' AS stage, COUNT(*) AS total_users FROM funnel\r\nUNION ALL\r\nSELECT '2. Home Try-On' AS stage, SUM(CASE WHEN is_home_try_on THEN 1 ELSE 0 END) FROM funnel\r\nUNION ALL\r\nSELECT '3. Purchase' AS stage, SUM(CASE WHEN is_purchase THEN 1 ELSE 0 END) FROM funnel;",
                        "sql": {
                          "columns": [
                            {
                              "parameters": [],
                              "type": "function"
                            }
